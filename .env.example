# Required: ScreenConnect instance HTTPS URL only (http is rejected)
SCREENCONNECT_BASE_URL=https://your-instance.example.com

# Required: RESTful API Manager extension shared secret (CTRLAuthHeader)
SCREENCONNECT_API_SECRET=

# Optional: extension GUID (ConnectWise Labs RESTful API Manager default)
# SCREENCONNECT_EXTENSION_ID=2d558935-686a-4bd0-9991-07539f5fe749

# Optional: must match the extension's RESTfulAllowedOrigin when that is set
# SCREENCONNECT_ORIGIN=https://your-instance.example.com

# Optional: comma-separated FULL session group paths. Empty = no group filter.
# Leave EMPTY if your instance does not return SessionGroupPath/GroupName on
# list/details (otherwise the allowlist blocks every session). Use full paths,
# not short tokens like "IT".
# SCREENCONNECT_ALLOWED_GROUPS=All Machines/Customer A,All Machines/Customer B

# Tool mode: read (default) | write | destructive
SCREENCONNECT_MODE=read

# Required for destructive tools (commands / toolbox / create_session)
SCREENCONNECT_ENABLE_COMMANDS=false

# Optional client limits
# SCREENCONNECT_TIMEOUT_MS=30000
# SCREENCONNECT_MAX_COMMAND_OUTPUT_CHARS=16000
# SCREENCONNECT_MAX_RESPONSE_BYTES=10485760

# Transport: stdio (default) or http (single-tenant Streamable HTTP on /mcp)
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080
# Required when MCP_TRANSPORT=http (minimum 32 characters):
# MCP_HTTP_BEARER_TOKEN=
# Optional comma-separated allowed Origin headers / hostnames (defaults to localhost):
# MCP_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:8080
