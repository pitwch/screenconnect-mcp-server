{
  "name": "screenconnect-mcp-server",
  "version": "0.1.2",
  "description": "MCP server for ConnectWise ScreenConnect RESTful API Manager (MSP-safe read/write/destructive modes)",
  "type": "module",
  "license": "MIT",
  "author": "Pedrett IT+Web AG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitwch/screenconnect-mcp-server.git"
  },
  "homepage": "https://github.com/pitwch/screenconnect-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/pitwch/screenconnect-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "screenconnect",
    "connectwise",
    "msp",
    "modelcontextprotocol"
  ],
  "bin": {
    "screenconnect-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.de.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-stdio.mjs",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
